generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Checklist {
  id          String   @id @default(cuid())
  slug        String   @unique
  editorToken String   @unique @default(uuid())
  clientName  String
  ownerEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version       Int      @default(0)
  fieldVersions Json?    @default("{}")
  notificationState Json?

  enabledTabs             Json?
  tabOrder                Json?
  tabFilledBy             Json?
  communicationChannels   Json?
  featureToggles          Json?
  configuratorChecklist   Json?

  companyInfo   Json?
  users         Json?
  campaigns     Json?
  sites         Json?
  prescreening  Json?
  messaging     Json?
  sources       Json?
  folders       Json?
  documents     Json?
  attributes    Json?
  fbWhatsapp    Json?
  instagram     Json?
  aiCallFaqs    Json?
  agencyPortal      Json?
  agencyPortalUsers Json?
  rejectionReasons  Json?
  labels            Json?
  adminSettings     Json?
  atsIntegrations   Json?
  integrations      Json     @default("[]")
  tabUploadMeta     Json?

  autoflows      Json?

  isCustom       Boolean  @default(false)
  customSchema   Json?
  customData     Json?
  customTabs     Json?

  snapshots      ChecklistSnapshot[]

  @@index([clientName])
}

model ChecklistSnapshot {
  id                String    @id @default(cuid())
  checklistId       String
  checklist         Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  label             String?
  description       String?
  isLabeled         Boolean   @default(false)

  payload           Json
  versionAtSnapshot Int

  createdAt         DateTime  @default(now())
  createdBy         String
  createdByLabel    String?

  archived          Boolean   @default(false)
  archivedAt        DateTime?

  @@index([checklistId, createdAt])
  @@index([checklistId, archived])
}

model RequirementsTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?
  category       String?
  tabName        String
  tabDescription String?
  tabIcon        String?
  fields         Json
  validationGroups Json?
  version        Int      @default(1)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([archived, updatedAt])
  @@index([name])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  // editor (can change things; the default) | viewer (read-only). Plain string validated in code (src/lib/roles.ts).
  role         String   @default("editor")
  createdAt    DateTime @default(now())

  // Back-relations for Claude connector sign-in (no column on this table).
  mcpTokens    McpToken[]
  mcpAuthCodes McpAuthCode[]
}

// =============================================================================
// Project Tracker (additive: new tables only, nothing above this line changes)
// Status-like fields are plain strings validated in code (src/lib/tracker),
// matching how this schema already stores values, and so a new status can be
// added later without a database enum migration.
// Dates that mean "a calendar day" use @db.Date so time zones cannot shift them.
// =============================================================================

model TrackerAccount {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people    TrackerPerson[]
  projects  TrackerProject[]

  @@index([name])
}

// A person who can own items. accountId null = Talkpush staff.
// side: talkpush | client | vendor
model TrackerPerson {
  id            String   @id @default(cuid())
  accountId     String?
  account       TrackerAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  side          String
  name          String
  email         String?
  title         String?
  organisation  String?
  adminUserId   String?  // loose link to AdminUser.id, deliberately not a foreign key
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedItems       TrackerItem[]      @relation("ItemOwner")
  sponsoredProjects TrackerProject[]  @relation("ProjectSponsor")
  ownedProjects    TrackerProject[]   @relation("ProjectOwner")
  shareLinks       TrackerShareLink[]

  @@index([accountId])
  @@index([side])
}

// status: planned | active | on_hold | completed
// healthOverride: on_track | at_risk | off_track (null = calculated)
model TrackerProject {
  id                  String   @id @default(cuid())
  accountId           String
  account             TrackerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  title               String
  objective           String?
  status              String   @default("planned")
  startDate           DateTime? @db.Date
  targetDate          DateTime? @db.Date
  originalTargetDate  DateTime? @db.Date
  goLiveDate          DateTime? @db.Date
  rescheduleCount     Int      @default(0)
  healthOverride      String?
  healthOverrideNote  String?
  sponsorPersonId     String?
  sponsor             TrackerPerson? @relation("ProjectSponsor", fields: [sponsorPersonId], references: [id], onDelete: SetNull)
  ownerPersonId       String?
  owner               TrackerPerson? @relation("ProjectOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  checklistId         String?  // reference to Checklist.id, deliberately not a foreign key
  archived            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  phases     TrackerPhase[]
  items      TrackerItem[]
  metrics    TrackerMetric[]
  shareLinks TrackerShareLink[]
  activity   TrackerActivity[]
  files      TrackerProjectFile[]

  @@index([accountId])
  @@index([status, archived])
}

model TrackerPhase {
  id           String   @id @default(cuid())
  projectId    String
  project      TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int      @default(0)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  exitCriteria String?
  createdAt    DateTime @default(now())

  items TrackerItem[]

  @@index([projectId, sortOrder])
}

// type: config | integration | uat | training | decision | risk | issue
// priority: high | medium | low
// status: not_started | in_progress | waiting_on_client | blocked | done | dropped
// visibility: client_visible | internal
// createdVia: web | mcp | client
model TrackerItem {
  id                 String   @id @default(cuid())
  projectId          String
  project            TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId            String?
  phase              TrackerPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  type               String   @default("config")
  priority           String   @default("medium")
  status             String   @default("not_started")
  visibility         String   @default("client_visible")
  isMilestone        Boolean  @default(false)
  ownerPersonId      String?
  owner              TrackerPerson? @relation("ItemOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  startDate          DateTime? @db.Date
  dueDate            DateTime? @db.Date
  completedAt        DateTime?
  blockerReason      String?
  waitingOn          String?
  externalDependency String?
  links              Json     @default("[]")
  checklistTabSlug   String?
  sortOrder          Int      @default(0)
  archived           Boolean  @default(false)
  createdVia         String   @default("web")
  templateItemKey    String?  // which standard-plan item this was created from (null = added by hand)
  staffReviewedAt    DateTime? // when staff reviewed an item a client added (null on a client-added item = still needs review)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  blockedBy TrackerItemDependency[] @relation("DependentItem")
  blocks    TrackerItemDependency[] @relation("BlockingItem")
  remarks   TrackerRemark[]

  @@index([projectId, status])
  @@index([projectId, sortOrder])
  @@index([projectId, templateItemKey])
  @@index([ownerPersonId])
  @@index([dueDate])
}

// "itemId cannot finish until blockedByItemId is done"
model TrackerItemDependency {
  id              String   @id @default(cuid())
  itemId          String
  item            TrackerItem @relation("DependentItem", fields: [itemId], references: [id], onDelete: Cascade)
  blockedByItemId String
  blockedByItem   TrackerItem @relation("BlockingItem", fields: [blockedByItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([itemId, blockedByItemId])
  @@index([blockedByItemId])
}

// visibility: shared | internal (default internal)
model TrackerRemark {
  id          String   @id @default(cuid())
  itemId      String
  item        TrackerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  body        String
  visibility  String   @default("internal")
  authorLabel String
  createdVia  String   @default("web")
  createdAt   DateTime @default(now())

  @@index([itemId, createdAt])
}

// direction: higher_is_better | lower_is_better
model TrackerMetric {
  id            String   @id @default(cuid())
  projectId     String
  project       TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  unit          String
  direction     String   @default("higher_is_better")
  baselineValue Float?
  baselineDate  DateTime? @db.Date
  targetValue   Float?
  currentValue  Float?
  currentAsOf   DateTime? @db.Date
  source        String?
  visibility    String   @default("client_visible")
  sortOrder     Int      @default(0)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  readings TrackerMetricReading[]

  @@index([projectId, sortOrder])
}

model TrackerMetricReading {
  id         String   @id @default(cuid())
  metricId   String
  metric     TrackerMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  value      Float
  asOf       DateTime @db.Date
  note       String?
  createdVia String   @default("web")
  createdAt  DateTime @default(now())

  @@index([metricId, asOf])
}

// via: web | mcp | client
model TrackerActivity {
  id         String   @id @default(cuid())
  projectId  String
  project    TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  actorLabel String
  via        String   @default("web")
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

// A file kept with a project: a signed contract, a Gantt chart, notes. Staff only; never part of the client view.
// The bytes live in the PRIVATE storage bucket "project-files" at storagePath; this row is the index.
// kind: contract | timeline | other. A removed file is only hidden (archived), like items.
model TrackerProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  project     TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String   @default("contract")
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String   @unique
  note        String?
  uploadedBy  String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([projectId, archived, createdAt])
}

// kind: viewer | contributor. Only a hash of the secret link token is stored.
model TrackerShareLink {
  id          String   @id @default(cuid())
  projectId   String
  project     TrackerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String
  personId    String?
  person      TrackerPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
  label       String?
  tokenHash   String   @unique
  tokenHint   String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// =============================================================================
// Standard implementation plan (additive). A catalogue of items that a project
// plan is built from. Building a plan COPIES the ticked items into the project
// (TrackerItem), so later template edits never change a live project.
// audience: internal | shared | client
//   internal = Talkpush only (item visibility internal)
//   shared   = Talkpush does it, client can see it (client_visible, owner side talkpush)
//   client   = client does it, client can see it (client_visible, owner side client)
// startDay / endDay are 1-based WORKING-day offsets from the project start date
// (Monday to Friday; day 1 is the start date, rolled forward off a weekend).
// phaseWeeks example: {"Scoping":[1,2],"Configuration":[3,4]} (weeks of 5 working days)
// =============================================================================

model TrackerPlanTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  version     Int      @default(1)
  phaseWeeks  Json     @default("{}")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items TrackerPlanTemplateItem[]
}

model TrackerPlanTemplateItem {
  id              String   @id @default(cuid())
  templateId      String
  template        TrackerPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key             String   // stable id, never renamed once used in a project
  phaseName       String
  groupName       String
  title           String
  description     String?
  type            String   @default("config")
  priority        String   @default("medium")
  audience        String   @default("shared")
  isMilestone     Boolean  @default(false)
  defaultIncluded Boolean  @default(true)
  startDay        Int?
  endDay          Int?
  dependsOnKeys   Json     @default("[]")
  sortOrder       Int      @default(0)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

// =============================================================================
// Claude connector sign-in (OAuth). Additive: new tables only.
// Codes and tokens are stored as SHA-256 hashes, never in the clear.
// =============================================================================

/// One row per app that registered itself with us (claude.ai, Claude Desktop, Claude Code ...).
model McpOAuthClient {
  id           String        @id @default(cuid())
  clientName   String
  redirectUris Json
  createdAt    DateTime      @default(now())
  lastUsedAt   DateTime?
  codes        McpAuthCode[]
  tokens       McpToken[]
}

/// A one-time code returned after someone clicks Allow. Lives about a minute, usable once.
model McpAuthCode {
  id            String         @id @default(cuid())
  codeHash      String         @unique
  clientId      String
  client        McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adminUserId   String
  adminUser     AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scope         String         @default("mcp")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([expiresAt])
}

/// One row per connected person and app. Revoking sets revokedAt. Deleting the admin login deletes the row.
model McpToken {
  id               String         @id @default(cuid())
  clientId         String
  client           McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adminUserId      String
  adminUser        AdminUser      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  accessTokenHash  String         @unique
  refreshTokenHash String         @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  scope            String         @default("mcp")
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  @@index([adminUserId])
  @@index([clientId])
}

// =============================================================================
// Workflow Builder (additive: new tables only, nothing above this line changes)
// Ported from the Workflow Editor. Status-like fields are plain strings validated in code.
// nodes/edges/viewport are a legacy mirror of pages[0]; pages is the source of truth.
// =============================================================================

// status: draft | shared | approved | changes_requested | modified_since_approval
model WorkflowProject {
  id             String   @id @default(cuid())
  clientName     String
  workflowName   String
  description    String?
  status         String   @default("draft")
  templateId     String?
  nodes          Json     @default("[]")
  edges          Json     @default("[]")
  viewport       Json     @default("{\"x\":0,\"y\":0,\"zoom\":1}")
  pages          Json     @default("[]") // [{ id, name, nodes, edges, viewport }]
  shareToken     String?  @unique
  currentVersion Int      @default(0)
  shareVersionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Phase 2 (access and sharing). revision goes up by one on every saved change, so two people editing
  // at once can be detected instead of silently overwriting each other.
  // generalAccess: restricted | anyone_with_link. publishedVersionId: the version clients see by default.
  revision           Int     @default(0)
  publishedVersionId String?
  generalAccess      String  @default("restricted")
  showFeasibility    Boolean @default(false)

  // Phase 3 (Process Map style). diagramStyle: classic | process_map. numberingScheme: letters | decimal.
  diagramStyle    String @default("classic")
  numberingScheme String @default("letters")
  // Readability pass. look: original | readable. Existing maps stay "original" (how they always looked); new maps are "readable".
  look            String @default("original")

  template         WorkflowTemplate?         @relation(fields: [templateId], references: [id])
  feedback         WorkflowFeedback[]
  versions         WorkflowVersion[]
  scopingArtifacts WorkflowScopingArtifact[]
  links            WorkflowLink[]
  members          WorkflowMember[]
  suggestions      WorkflowSuggestion[]
  comments         WorkflowComment[]
  auditEvents      WorkflowAuditEvent[]
  accessRequests   WorkflowAccessRequest[]

  @@index([clientName])
  @@index([status])
}

// kind: assumption | open_question | risk | decision | call_note | customer_summary
// status: open | confirmed | resolved | dismissed
// source: mcp | manual | transcript | validation
model WorkflowScopingArtifact {
  id         String   @id @default(cuid())
  workflowId String
  kind       String
  title      String
  detail     String
  status     String   @default("open")
  severity   String   @default("info")
  owner      String?
  source     String   @default("manual")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, kind])
  @@index([workflowId, status])
  @@index([workflowId, createdAt])
}

// industry: bpo | retail | general
model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  industry    String   @default("general")
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  createdAt   DateTime @default(now())

  workflows WorkflowProject[]

  @@index([industry])
}

// action: approved | changes_requested
model WorkflowFeedback {
  id           String   @id @default(cuid())
  workflowId   String
  action       String
  reviewerName String
  comment      String?
  createdAt    DateTime @default(now())

  // Phase 2: an approval belongs to a specific version, and to the person or link that gave it.
  versionId String?
  memberId  String?
  linkId    String?
  adminId   String?

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

// triggeredBy: status_change | manual | restore
model WorkflowVersion {
  id            String   @id @default(cuid())
  workflowId    String
  versionNumber Int
  label         String?
  status        String
  triggeredBy   String
  triggerDetail String?
  createdByName String?
  nodes         Json
  edges         Json
  viewport      Json?
  pages         Json?
  nodeCount     Int
  edgeCount     Int
  createdAt     DateTime @default(now())

  // Phase 2: which canvas revision this snapshot captured, and the named invite that caused it (if any).
  revision          Int?
  createdByMemberId String?

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, versionNumber])
  @@index([workflowId, createdAt])
}

// =============================================================================
// Workflow Builder phase 2: access, sharing, review. Additive: new tables only.
// Only a SHA-256 hash of any secret link is stored, never the link itself.
// =============================================================================

// level: view | comment | edit. editMode (edit links only): direct | suggest_only.
// A link is rotated by creating a new row and setting disabledAt on the old one.
model WorkflowLink {
  id               String    @id @default(cuid())
  workflowId       String
  level            String
  editMode         String    @default("direct")
  canApprove       Boolean   @default(false)
  tokenHash        String    @unique
  tokenHint        String?
  passcodeHash     String?
  expiresAt        DateTime?
  disabledAt       DateTime?
  createdByAdminId String
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, level])
}

// A named invite (a personal link for one person). level: viewer | commenter | editor.
model WorkflowMember {
  id                   String    @id @default(cuid())
  workflowId           String
  level                String
  editMode             String    @default("direct")
  canAcceptSuggestions Boolean   @default(false)
  displayName          String
  email                String?
  emailVerified        Boolean   @default(false)
  canApprove           Boolean   @default(false)
  canComment           Boolean   @default(true)
  tokenHash            String    @unique
  tokenHint            String?
  expiresAt            DateTime?
  revokedAt            DateTime?
  firstOpenedAt        DateTime?
  lastSeenAt           DateTime?
  createdByAdminId     String
  createdAt            DateTime  @default(now())

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

// A proposed change from an editor in suggest-only mode. ops is the same list of changes a direct save uses.
// status: pending | accepted | rejected | withdrawn | stale
model WorkflowSuggestion {
  id                String    @id @default(cuid())
  workflowId        String
  authorMemberId    String?
  authorGuestName   String
  baseRevision      Int
  ops               Json
  summary           String?
  status            String    @default("pending")
  resolvedByAdminId String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
}

// A note pinned to a step, a connector or a spot on a page. status: open | resolved
model WorkflowComment {
  id             String    @id @default(cuid())
  workflowId     String
  pageId         String
  nodeId         String?
  edgeId         String?
  x              Float?
  y              Float?
  versionId      String?
  parentId       String?
  body           String
  authorAdminId  String?
  authorMemberId String?
  authorName     String
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
}

// Who did what. actorType: admin | member | guest | mcp | system
model WorkflowAuditEvent {
  id         String   @id @default(cuid())
  workflowId String
  actorType  String
  actorId    String?
  actorName  String?
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
}

// "Request access" from a link that no longer works. No email is sent; it shows in the staff inbox.
// status: open | handled
model WorkflowAccessRequest {
  id         String   @id @default(cuid())
  workflowId String
  name       String
  email      String?
  message    String?
  status     String   @default("open")
  createdAt  DateTime @default(now())

  workflow WorkflowProject @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, status])
}
