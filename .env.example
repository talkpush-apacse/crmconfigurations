# Database connection (Prisma v7 format for migrations)
DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=your-api-key-here

# Direct PostgreSQL connection (used at runtime by pg adapter)
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/database

# JWT secret for admin authentication (REQUIRED in production)
ADMIN_SECRET=your-secret-here

# Google OAuth for admin sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=  # e.g. https://<domain>/api/auth/google/callback

# Public app base URL used in owner-notification links
APP_BASE_URL=https://crm.example.com

# Brevo owner notifications
BREVO_API_KEY=
NOTIFICATION_FROM_EMAIL="CRM Checklist <updates@updates.se-talkpush.com>"

# Optional external cron auth for /api/cron/notifications
CRON_SECRET=replace-with-a-long-random-string

# Project Tracker MCP endpoint (/api/mcp/tracker). Use a long random value (24+ characters),
# different from MCP_API_KEY so each can be rotated on its own.
TRACKER_MCP_API_KEY=

# Optional: IANA time zone used for "today" in the tracker (default UTC), e.g. Asia/Manila
TRACKER_TIMEZONE=

# Optional: extra exact return addresses an app may use when connecting through Claude sign-in
# (comma separated, https only). Claude's own addresses and local apps are already allowed.
MCP_OAUTH_EXTRA_REDIRECTS=

# Workflow Builder MCP endpoint (/api/mcp/workflows). Long random value (32+ characters), different from the
# other MCP keys. Sent as "Authorization: Bearer <key>"; it is NOT accepted in the web address.
WORKFLOW_MCP_API_KEY=

# Combined MCP endpoint (/api/mcp/all): checklist + tracker + workflow tools behind one URL. OPTIONAL: people
# normally connect through Claude sign-in and need no key. Set this only for scripts. Long random value (32+
# characters), different from every other MCP key (the other keys are NOT accepted here). Bearer header only.
COMBINED_MCP_API_KEY=

# Optional: the address client links (the "Share" links and the Claude connector's client links) are built on, for client
# networks that only allow certain hosts, for example https://status.talkpush.com. It must serve this same app and must NOT
# be the staff address above. When set, that address opens client pages only (/share, /contribute, /w); staff screens are
# not available there. When empty, links use the address the Hub was reached on.
CLIENT_LINK_BASE_URL=
